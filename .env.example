APP_NAME=Bright Store API
APP_ENV=uat
DEBUG=false
API_PREFIX=/api/v1
# Same PostgreSQL database as Gramik CRM. Do not point this at a separate database.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/db_agri_junction
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# Read-only Odoo key for the inventory webtech agent. Never commit the real key.
ODOO_CRM_API_KEY=
ODOO_JSON2_URL=
ODOO_CRM_BASE_URL=
# Read-only path. The reconciliation bot does not modify this workbook.
RECONCILIATION_WORKBOOK=
# Amazon SES SMTP, same values as Gramik CRM. Never commit the real password.
SES_SMTP_HOST=
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
SES_FROM_EMAIL=noreply@gramik.in
SES_FROM_NAME=WebTechAgent AI Assistant
